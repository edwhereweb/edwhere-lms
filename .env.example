# ── Clerk Authentication ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<yourownkey>
CLERK_SECRET_KEY=sk_test_<yourownkey>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Database (MongoDB) ───────────────────────────────
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority"

# ── Cloudflare R2 (File Uploads) ─────────────────────
R2_ACCOUNT_ID=<your_cloudflare_account_id>
R2_ACCESS_KEY_ID=<your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
R2_BUCKET_NAME=<your_r2_bucket_name>

# ── Mux (Video Streaming) ────────────────────────────
MUX_TOKEN_ID=<yourownid>
MUX_TOKEN_SECRET=<yourownsecret>

# ── Application ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DEBUG_LOGS=true  # Set to "false" in production

# ── Razorpay (Payments) ─────────────────────────────
RAZORPAY_KEY_ID=rzp_test_<yourownkeyid>
RAZORPAY_KEY_SECRET=<yourownsecret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_<yourownkeyid>

# ── Mobile App Version Gating ───────────────────────
# Minimum supported app version per platform (semver)
MOBILE_MIN_IOS=1.0.0
MOBILE_MIN_ANDROID=1.0.0
# Latest published app version per platform (semver)
MOBILE_LATEST_IOS=1.0.0
MOBILE_LATEST_ANDROID=1.0.0
# Set to "true" to force all users below min version to upgrade
MOBILE_FORCE_UPGRADE=false

# ── WACRM (WhatsApp API for webinar confirmations) ───
# All three vars must be set for WhatsApp messages to be sent.
# If any are missing, confirmations are silently skipped.
WACRM_API_URL=https://wacrm.edwhere.com/api/v1
WACRM_API_KEY=<your_wacrm_api_key>
WACRM_TEMPLATE_ID=<your_whatsapp_template_id>
WACRM_REMINDER_TEMPLATE_ID=<your_whatsapp_reminder_template_id>
WACRM_REMINDER_1H_TEMPLATE_ID=<your_whatsapp_1h_reminder_template_id>
WACRM_REMINDER_0M_TEMPLATE_ID=<your_whatsapp_0m_reminder_template_id>
# Template for post-enrollment WhatsApp notification (body params: name, courseTitle, appDownloadLink, whatsappGroupUrl)
WACRM_ENROLLMENT_TEMPLATE_ID=<your_enrollment_template_id>

# ── App Download Link (used in enrollment WhatsApp messages) ─────────────────
# Set to your App Store / Play Store URL or a universal link
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://edwhere.com/app

# ── LMS → CRM enrollment sync (docs/CRM-ENROLLMENT-SYNC.md) ───
# Max delivery attempts per enrollment before it stays FAILED (default 5)
CRM_SYNC_MAX_ATTEMPTS=5
# Backoff base in seconds; delay = base * 2^(attempt-1), capped at 6h (default 60)
CRM_SYNC_BACKOFF_BASE_SECONDS=60
# Max jobs processed per reconcile/backfill run (default 50)
CRM_SYNC_BATCH_SIZE=50
# Shared secret for /api/cron/crm-enrollment-sync (min 16 chars). Route is disabled if unset.
CRM_SYNC_SECRET=<long_random_string>

# ── Google Meet live sessions ─────────────────────────────────────────────────
# Global kill switch. A course also needs googleMeetEnabled=true. When "true",
# the five vars below (domain, SA email/key, subject, internal secret) are required.
GOOGLE_MEET_ENABLED=false
# When "true" (default) a failed instructor cohost assignment fails the whole create. When
# "false" the session is still saved with hostConfigStatus=FAILED.
GOOGLE_MEET_STRICT_COHOST=true
GOOGLE_WORKSPACE_DOMAIN=school.edu
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=<service_account>@<project>.iam.gserviceaccount.com
# Keep literal \n sequences for newlines when set in an env file
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Workspace user the service account impersonates (domain-wide delegation)
GOOGLE_DELEGATED_SUBJECT=admin@school.edu
# Shared secret for /api/internal/live-sessions/reconcile (min 16 chars)
GOOGLE_MEET_INTERNAL_SECRET=<long_random_string>
GOOGLE_MEET_RECONCILE_BATCH_SIZE=20
GOOGLE_MEET_RECONCILE_MAX_RETRIES=6
GOOGLE_MEET_RECONCILE_INITIAL_DELAY_MIN=5
GOOGLE_MEET_RECONCILE_MAX_DELAY_MIN=60
